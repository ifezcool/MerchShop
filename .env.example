# ========================================================
# MyAnimeList Developer API Credentials
# Create your app at: https://myanimelist.net/apiconfig
# ========================================================
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:8501

# ========================================================
# Supabase Configuration (Optional - Local SQLite used by default)
# ========================================================
SUPABASE_URL=
SUPABASE_KEY=

# ========================================================
# eBay Developer API Credentials (Browse API)
# Create your application keys at: https://developer.ebay.com
# Use Production Client ID (App ID) and Client Secret (Cert ID)
# ========================================================
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# ========================================================
# Server & Cache Settings
# ========================================================
STREAMLIT_PORT=8501
ANIME_LIST_TTL_SECONDS=604800
PRODUCT_SEARCH_TTL_SECONDS=86400
